<div class="col">
  <a class="research-card" href="{{ project.url | relative_url }}">
    <div class="card h-100">
      {% if project.img %}
        {% include figure.liquid path=project.img sizes="(min-width: 768px) 450px, 95vw" alt=project.img_alt class="card-img-top" %}
      {% endif %}
      <div class="card-body">
        <p class="research-context">{{ project.research_context }}</p>
        <h3 class="card-title">{{ project.title }}</h3>
        <p class="card-text">{{ project.description }}</p>
        <span class="research-read">Explore this theme <span aria-hidden="true">→</span></span>
      </div>
    </div>
  </a>
</div>
