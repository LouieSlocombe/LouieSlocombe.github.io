---
layout: default
---
{% assign resume = site.data.resume %}
<div class="post cv-page" id="cv-top">
  <header class="cv-header">
    <p class="cv-eyebrow">Curriculum vitae</p>
    <h1>{{ resume.basics.name | escape }}</h1>
    <p class="cv-subtitle">{{ resume.basics.label | escape }}</p>
    <div class="cv-actions">
      <a href="mailto:{{ resume.basics.email | escape }}">{{ resume.basics.email | escape }}</a>
    </div>
    <p class="cv-summary">{{ resume.basics.summary | escape }}</p>
    <ul class="cv-profile-links" aria-label="Research profiles">
      {% for profile in resume.basics.profiles %}
        <li>
          <a href="{{ profile.url | escape }}">{{ profile.network | escape }}</a>
        </li>
      {% endfor %}
    </ul>
    <dl class="cv-highlights">
      {% for highlight in resume.highlights %}
        <div>
          <dt>{{ highlight.label | escape }}</dt>
          <dd class="cv-highlight-value">{{ highlight.value | escape }}</dd>
          <dd class="cv-highlight-detail">{{ highlight.detail | escape }}</dd>
        </div>
      {% endfor %}
    </dl>
  </header>

  <div class="cv-body">
    <nav class="cv-nav" aria-label="CV sections">
      <p class="cv-eyebrow">On this page</p>
      <ul>
        {% for section in site.data.cv_sections %}
          <li>
            <a href="#{{ section.key }}">{{ section.nav | escape }}</a>
          </li>
        {% endfor %}
      </ul>
      <a class="cv-back-to-top" href="#cv-top">Back to top ↑</a>
    </nav>
    <article class="cv-content" aria-label="Curriculum vitae details">
      {% for section in site.data.cv_sections %}
        {% assign section_entries = resume[section.key] %}
        <section class="cv-section" id="{{ section.key }}" aria-labelledby="{{ section.key }}-heading">
          <h2 id="{{ section.key }}-heading">{{ section.title | escape }}</h2>
          {% case section.type %}
            {% when 'entries' %}
              {% include cv/entries.liquid entries=section_entries %}
            {% when 'skills' %}
              {% include cv/skills.liquid skills=resume.skills %}
            {% when 'groups' %}
              {% include cv/groups.liquid groups=section_entries %}
            {% when 'bibliography' %}
              {% if section.key == 'publications' %}
                <p class="cv-section-intro">
                  Papers from my work on quantum biology, molecular simulation, and chemical complexity.
                  <a href="{{ '/publications/' | relative_url }}">Search the publication list →</a>
                </p>
                <h3 class="cv-group-title">Journal articles & accepted papers</h3>
                {% bibliography --template cv_bib --group_by none --query @*[cv_group=published] %}
                <h3 class="cv-group-title">Conference contributions</h3>
                {% bibliography --template cv_bib --group_by none --query @*[cv_group=conference] %}
              {% else %}
                {% bibliography --template cv_bib --group_by none --query @*[cv_group=preprint] %}
              {% endif %}
          {% endcase %}
        </section>
      {% endfor %}
    </article>
  </div>
</div>
